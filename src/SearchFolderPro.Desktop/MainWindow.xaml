<Window x:Class="SearchFolderPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Folder Pro"
        Width="1180" Height="780" MinWidth="900" MinHeight="620"
        Background="#F4F6F1" Foreground="#20312A"
        FontFamily="Segoe UI Variable Text" FontSize="14"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#20312A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#236B4A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Foreground" Value="#E4EEE7" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#D6E0D7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E8E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAF7" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1ED" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="40" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E352A" Padding="22,26">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SEARCH" Foreground="#A8C6B1" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Folder Pro" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,28" />
                    <Button x:Name="SearchNavButton" Content="Buscar archivos" Style="{StaticResource NavButton}" Click="ShowSearch_Click" Background="#31533F" />
                    <Button x:Name="FoldersNavButton" Content="Carpetas" Style="{StaticResource NavButton}" Click="ShowFolders_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Búsqueda local" Foreground="#A8C6B1" FontSize="12" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Buscar archivos" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Busca por nombre, tipo, tamaño, fecha o texto." Foreground="#718078" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="SearchView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Height="48" FontSize="16" Padding="14,10" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                            <TextBlock x:Name="SearchHint" Text="Nombre o texto del archivo" Foreground="#8A978F" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Search_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="#EAF0E9" Padding="14,11" Margin="0,0,0,14">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Tipo" FontSize="11" Foreground="#718078" Margin="0,0,0,4" />
                                <TextBox x:Name="ExtensionBox" Width="105" Text="" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Tamaño mínimo (MB)" FontSize="11" Foreground="#718078" Margin="0,0,0,4" />
                                <TextBox x:Name="MinimumSizeBox" Width="120" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Tamaño máximo (MB)" FontSize="11" Foreground="#718078" Margin="0,0,0,4" />
                                <TextBox x:Name="MaximumSizeBox" Width="120" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Modificado después de" FontSize="11" Foreground="#718078" Margin="0,0,0,4" />
                                <DatePicker x:Name="ModifiedAfterPicker" Width="155" />
                            </StackPanel>
                            <CheckBox x:Name="SearchContentsCheckBox" Content="Buscar en texto" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="ResultsGrid" Grid.Row="2" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Carpeta" Binding="{Binding DirectoryPath}" Width="3*" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Extension}" Width="90" />
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeLabel}" Width="110" />
                            <DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedLabel}" Width="145" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="FoldersView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Carpetas del índice" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Los cambios se actualizan automáticamente mientras la app está abierta." Foreground="#718078" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Quitar" Click="RemoveFolder_Click" />
                            <Button x:Name="CancelIndexButton" Content="Cancelar" Click="CancelIndex_Click" IsEnabled="False" />
                            <Button Content="Actualizar" Click="IndexFolders_Click" />
                            <Button Content="Agregar carpeta" Style="{StaticResource PrimaryButton}" Click="AddFolder_Click" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="FoldersList" Grid.Row="1" Background="White" BorderBrush="#E1E8E1" BorderThickness="1" Padding="8" />
                </Grid>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="Agrega una carpeta para empezar." Foreground="#718078" VerticalAlignment="Center" />
                <ProgressBar x:Name="IndexProgress" DockPanel.Dock="Right" Width="190" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>